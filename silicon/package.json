{
  "name": "@myclaw/silicon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "silicon": "./dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "desktop": "pnpm build && node apps/desktop/launch.mjs",
    "desktop:electron": "pnpm build && electron apps/desktop/main.cjs",
    "ui": "node dist/http/server.js",
    "start": "node dist/cli/bin.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^42.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
